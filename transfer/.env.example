# ─────────────────────────────────────────────────────────────
# SafeWord environment
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# --- Discord bot ---
# Bot-Token aus dem Discord Developer Portal
# (https://discord.com/developers/applications -> deine App -> Bot -> Token).
# Das ist der "Schlüssel", mit dem sich dein Bot bei Discord anmeldet.
DISCORD_TOKEN=your_bot_token

# Deine Discord-IDs (kommagetrennt), die im BOT als Besitzer gelten
# (Owner-Befehle). Discord-ID: Discord -> Einstellungen -> Erweitert ->
# "Entwicklermodus" an, dann Rechtsklick auf deinen Namen -> ID kopieren.
BOT_OWNER_IDS=1234567890

# --- Discord OAuth2 (API / Dashboard login) ---
# Application-ID deiner Discord-App
# (Discord Developer Portal -> General Information -> Application ID).
DISCORD_CLIENT_ID=your_client_id

# OAuth2-Secret deiner Discord-App
# (Discord Developer Portal -> OAuth2 -> General -> Client Secret).
DISCORD_CLIENT_SECRET=your_client_secret

# Redirect-URL nach dem Discord-Login. MUSS exakt der URL entsprechen,
# die du im Developer Portal unter OAuth2 -> Redirects eingetragen hast.
#
# WICHTIG: Das Dashboard (Port 3000 bzw. Vercel) leitet alle /api/*-Aufrufe
# serverseitig an die API weiter. Damit der Login-Cookie beim Dashboard
# ankommt, muss die Redirect-URI ueber den DASHBOARD-Host laufen:
#   Lokal:  http://localhost:3000/api/auth/callback
#   Vercel: https://deine-dashboard-app.vercel.app/api/auth/callback
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Wohin die API den User nach erfolgreichem Discord-Login weiterleitet.
#   Lokal:  http://localhost:3000/dashboard
#   Vercel: https://deine-dashboard-app.vercel.app/dashboard
DASHBOARD_URL=http://localhost:3000

# Invite-Link zum Einladen des Bots (nur Referenz/Kopieren).
# "CLIENT_ID" durch deine echte Application-ID ersetzen und im Browser
# öffnen. Die Permissions 328566625280 sind die nötigen Bot-Rechte.
# Das Dashboard nutzt stattdessen NEXT_PUBLIC_INVITE_URL (in Vercel).
DISCORD_INVITE_URL=https://discord.com/oauth2/authorize?client_id=CLIENT_ID&permissions=328566625280&scope=bot%20applications.commands

# --- Developer admin whitelist (comma separated Discord IDs) ---
# Deine Discord-ID (kommagetrennt). Diese User haben im ADMIN-BEREICH des
# Dashboards Owner-Rechte. WICHTIG: das ist die Absicherung des Admin-Panels!
ADMIN_WHITELIST_IDS=1234567890

# --- PostgreSQL ---
# Wird von docker-compose überschrieben (Host "db", der DB-Container),
# d.h. im Docker-Betrieb NICHT ändern. Nur wenn du Bot/API ohne Docker
# lokal startest, trage hier deine lokale Postgres-Instanz ein.
DATABASE_URL=postgresql://safeword:safeword@localhost:5432/safeword

# --- API / JWT ---
# Hinweis: API_HOST/API_PORT werden aktuell NICHT von der App gelesen
# (Port/Host sind in Dockerfile.api fest: 0.0.0.0:8000). Können so
# stehen bleiben, sind nur Dokumentation.
API_HOST=0.0.0.0
API_PORT=8000

# WICHTIG: langes, zufälliges Secret zum Signieren der Login-Sessions.
# Erzeugen mit:  openssl rand -hex 32
# In Produktion UNBEDINGT ändern, sonst können Sessions gefälscht werden.
JWT_SECRET=change_me_to_a_long_random_string

# Wie lange eine Login-Session gültig ist (in Minuten). 720 = 12 Stunden.
JWT_EXPIRE_MINUTES=720

# Session-Cookie nur über HTTPS senden.
# Lokal (http://localhost): false. Online mit HTTPS: true.
# Bei true + http-Verbindung schlägt der Login fehl.
# In Produktion (Vercel) IMMER true.
COOKIE_SECURE=false

# Erlaubte Dashboard-URLs (kommagetrennt), die die API aufrufen dürfen.
# Lokal: http://localhost:3000
# Produktion: https://deine-dashboard-app.vercel.app
#            + https://dein-api-tunnel.trycloudflare.com (falls nötig)
CORS_ORIGINS=http://localhost:3000

# --- Dashboard ---
# Die echte Variable für den Dashboard-Build heißt NEXT_PUBLIC_API_URL und
# wird in VERCEL gesetzt (Projekt -> Settings -> Environment Variables) —
# nicht in dieser Server-.env. Das Dashboard leitet alle /api/*-Aufrufe
# serverseitig an diese URL weiter.
#   Lokal:  http://localhost:8000
#   Online: https://dein-api-tunnel.trycloudflare.com   (Cloudflare Tunnel)
#           oder deine eigene API-Domain, falls du eine hast.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Push-Benachrichtigungen (Web Push / Android) ---
# WICHTIG: Der Login-Session-Cookie ist HttpOnly und wird vom Dashboard
# serverseitig gesetzt — die Push-Abonnements liegen beim jeweiligen
# Discord-User in der Datenbank.
#
# VAPID-Schlüssel erzeugen mit:
#   python scripts/generate_vapid_keys.py
# (Installiert py_vapid via `pip install pywebpush` in der api-Umgebung.)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Deine E-Mail-Adresse (von den Browser-Push-Diensten benötigt).
VAPID_SUBJECT=mailto:you@example.com

# --- Sicherheit: Selbstschutz / Anti-Nuke ---
# Bot deaktiviert sich für einen Server selbst, wenn ein Angriffs-/Nuke-
# Versuch erkannt wird (Slash-Command-Flut, Erwähnungs-Flut, massenhafte
# Kanal-Löschung, Kick/Ban). Der Vorfall wird im Dashboard (Admin + Server)
# angezeigt und als Push-Benachrichtigung verschickt. Admin reaktiviert den
# Bot dort wieder.
#
# Erweiterte Erkennung schärfer stellen (kleinere Werte = empfindlicher):
# COMMAND_FLOOD_LIMIT=5
# COMMAND_FLOOD_WINDOW=10
# MENTION_FLOOD_LIMIT=8
# MENTION_FLOOD_WINDOW=10
# CHANNEL_NUKE_LIMIT=6
# CHANNEL_NUKE_WINDOW=15

# --- Webhook: Profilbild ändern ---
# Geheimer Schlüssel für den Profilbild-Webhook. Jeder Aufruf von
# POST /api/webhook/avatar braucht den Header:
#   X-Webhook-Secret: <AVATAR_WEBHOOK_SECRET>
# Body: {"image_url": "https://…"}  ODER  {"avatar": "data:image/png;base64,…"}
# Erzeugen mit:  openssl rand -hex 32
# Leer lassen (default) = Webhook deaktiviert.
AVATAR_WEBHOOK_SECRET=
